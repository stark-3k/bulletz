# Server
PORT=4000
DATABASE_URL=postgres://bulletz:bulletz@localhost:5433/bulletz
LOG_LEVEL=info

# MCP bridge (packages/mcp) -> server
BULLETZ_SERVER_URL=http://localhost:4000
BULLETZ_TOKEN=blz_t_replace_me
BULLETZ_WORKSPACE=

# Voice: ICE servers are served to clients, never baked into the bundle.
# Without TURN, peers behind symmetric NAT (~10-20% of connections) cannot
# connect at all. coturn with use-auth-secret is the usual answer.
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:voice.example.com:3478?transport=udp,turns:voice.example.com:5349?transport=tcp
# TURN_SECRET=<same static-auth-secret as coturn>   # preferred: short-lived credentials
# TURN_TTL=3600
# TURN_USERNAME=/TURN_PASSWORD=                      # fallback: static, shared by everyone
