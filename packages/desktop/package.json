{
  "name": "@bulletz/desktop",
  "version": "0.1.0-beta.6",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "brand": "node scripts/brand-dev-shell.mjs",
    "unbrand": "node scripts/brand-dev-shell.mjs --restore",
    "prestart": "npm run brand && npm run bundle:mcp",
    "start": "npm run build && electron .",
    "predev": "npm run brand && npm run bundle:mcp",
    "dev": "npm run build && BULLETZ_DEV_URL=http://localhost:5174 electron .",
    "prepackage": "npm run build && npm run build -w @bulletz/web -- --mode package && node scripts/check-no-secrets.mjs && npm run bundle:mcp",
    "package": "electron-builder --mac --publish never",
    "package:dir": "electron-builder --mac --dir --publish never",
    "rebuild": "electron-builder install-app-deps",
    "prepackage:dir": "npm run build && npm run build -w @bulletz/web -- --mode package && node scripts/check-no-secrets.mjs && npm run bundle:mcp",
    "package:mac": "electron-builder --mac --publish never",
    "package:win": "electron-builder --win --publish never",
    "prepackage:mac": "npm run build && npm run build -w @bulletz/web -- --mode package && node scripts/check-no-secrets.mjs && npm run bundle:mcp",
    "prepackage:win": "npm run build && npm run build -w @bulletz/web -- --mode package && node scripts/check-no-secrets.mjs && npm run bundle:mcp",
    "package:linux": "electron-builder --linux --publish never",
    "prepackage:linux": "npm run build && npm run build -w @bulletz/web -- --mode package && node scripts/check-no-secrets.mjs && npm run bundle:mcp",
    "rebuild:pty": "electron-rebuild -v 33.4.11 -f -w node-pty",
    "bundle:mcp": "node scripts/bundle-mcp.mjs"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.10.2",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "description": "The context layer for local coding agents.",
  "author": "Bulletz",
  "build": {
    "appId": "ai.bulletz.desktop",
    "productName": "Bulletz",
    "copyright": "© 2026 Bulletz",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/icon.icns",
      "assets/icon.png",
      "assets/mcp.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Bulletz uses the microphone for voice channels.",
        "NSCameraUsageDescription": "Bulletz uses the camera for voice channels."
      }
    },
    "dmg": {
      "title": "Bulletz ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "synopsis": "The context layer for local coding agents.",
      "executableName": "bulletz"
    },
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.cjs"
  }
}
